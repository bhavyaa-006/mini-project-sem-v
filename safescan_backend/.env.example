# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://safescan:safescan@localhost:5432/safescan_db

# ── JWT ────────────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── App ────────────────────────────────────────────────────────────────────────
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── External APIs ──────────────────────────────────────────────────────────────
# Optional: Google Gemini for AI summary  (leave blank to use rule-based fallback)
GEMINI_API_KEY=
